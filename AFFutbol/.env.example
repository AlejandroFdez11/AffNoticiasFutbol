# Football data (https://www.api-football.com/)
# Copy this file to `.env` and fill in your key.
EXPO_PUBLIC_API_FOOTBALL_KEY=
EXPO_PUBLIC_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Use `true` to develop against local mock data, `false` to always call the API.
# When empty, mocks are enabled automatically if no API key is present.
EXPO_PUBLIC_USE_MOCKS=true
