# AFFutbol — plantilla de variables de entorno.
# Copia este archivo a `.env` y rellena los valores:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Solo las variables `EXPO_PUBLIC_*` llegan a la app, y viajan en el bundle:
# son públicas. Los secretos (claves de servicio, secretos compartidos) se
# configuran en Supabase, nunca aquí.

# --- API-Football (https://dashboard.api-football.com) -----------------------
# Producción: la app llama a la Edge Function `api-football`, que guarda la clave
# en el servidor. Valor: https://<project-ref>.supabase.co/functions/v1/api-football
EXPO_PUBLIC_API_FOOTBALL_PROXY_URL=
# Solo para desarrollo local sin proxy. No lo uses en una build publicada: la
# clave viajaría dentro del bundle.
EXPO_PUBLIC_API_FOOTBALL_KEY=
EXPO_PUBLIC_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# `true` fuerza mocks, `false` fuerza datos reales. Vacío = mocks si no hay proxy
# ni clave.
EXPO_PUBLIC_USE_MOCKS=

# --- Supabase (Project Settings → API) --------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
# Publishable/anon key. Es pública; nunca pongas aquí la service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Notificaciones push (fase 6) -------------------------------------------
# Identificador del proyecto EAS, necesario para obtener el Expo push token.
# `npx eas-cli init` lo escribe en app.json (extra.eas.projectId); esta variable
# es un respaldo para builds locales.
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Solo para la CLI de EAS -------------------------------------------------
# No se incluye en el bundle; lo usa `npx eas-cli build` para autenticarse.
EXPO_TOKEN=
